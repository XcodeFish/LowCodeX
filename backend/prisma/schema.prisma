generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(uuid())
  username    String    @unique
  email       String    @unique
  password    String
  name        String?
  avatar      String?
  status      String    @default("active")
  tenantId    String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  lastLoginAt DateTime? @map("last_login_at")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  tenantId    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  tenantId    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("permissions")
}

model rolepermissions {
  A String
  B String

  @@unique([A, B], map: "_RolePermissions_AB_unique")
  @@index([B], map: "_RolePermissions_B_index")
  @@map("_rolepermissions")
}

model userroles {
  A String
  B String

  @@unique([A, B], map: "_UserRoles_AB_unique")
  @@index([B], map: "_UserRoles_B_index")
  @@map("_userroles")
}

model system_configs {
  id          String   @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  key         String   @unique @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.Text
  isPublic    Boolean  @default(true)
  group       String   @default("system") @db.VarChar(50)
  createdAt   DateTime @db.DateTime(0)
  updatedAt   DateTime @db.DateTime(0)
}

// 元表定义
model MetaTable {
  id            String        @id @default(uuid())
  name          String
  displayName   String
  description   String?       @db.Text
  isSystem      Boolean       @default(false)
  isSoftDelete  Boolean       @default(true)
  isVersioned   Boolean       @default(false)
  status        String        @default("draft")
  tenant        String
  application   String?
  createdBy     String
  createdAt     DateTime      @default(now())
  updatedBy     String?
  updatedAt     DateTime?     @updatedAt
  auditFields   Boolean       @default(true)
  apiEnabled    Boolean       @default(true)
  customOptions Json?

  // 关联关系
  fields        MetaField[]
  relations     MetaRelation[] @relation("SourceTables")
  targetRelations MetaRelation[] @relation("TargetTables")
  junctionRelations MetaRelation[] @relation("JunctionTables")
  versions      MetaVersion[]
  indexes       MetaIndex[]
  constraints   MetaConstraint[]
  modelApprovals ModelApproval[]
  testDataGenerations TestDataGeneration[]
  testDataTemplates TestDataTemplate[]

  @@unique([name, tenant, application])
  @@map("meta_tables")
}

// 元字段定义
model MetaField {
  id            String    @id @default(uuid())
  tableId       String
  name          String
  displayName   String
  description   String?   @db.Text
  type          String
  isPrimaryKey  Boolean   @default(false)
  isRequired    Boolean   @default(false)
  isUnique      Boolean   @default(false)
  isSystem      Boolean   @default(false)
  isHidden      Boolean   @default(false)
  ordinal       Int
  defaultValue  String?
  validationRules Json?
  isSearchable  Boolean   @default(false)
  isSortable    Boolean   @default(false)
  isFilterable  Boolean   @default(false)
  isAggregatable Boolean  @default(false)
  advancedSettings Json?

  // 关联关系
  table         MetaTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  sourceRelations MetaRelation[] @relation("SourceFields")
  targetRelations MetaRelation[] @relation("TargetFields")
  indexFields   MetaIndexField[]

  @@unique([tableId, name])
  @@map("meta_fields")
}

// 元关系定义
model MetaRelation {
  id            String    @id @default(uuid())
  name          String
  description   String?   @db.Text
  sourceTableId String
  targetTableId String
  sourceFieldId String
  targetFieldId String
  type          String
  cascadeDelete Boolean   @default(false)
  cascadeUpdate Boolean   @default(false)
  isRequired    Boolean   @default(false)
  junctionTableId String?
  customOptions Json?

  // 关联关系
  sourceTable   MetaTable @relation("SourceTables", fields: [sourceTableId], references: [id])
  targetTable   MetaTable @relation("TargetTables", fields: [targetTableId], references: [id])
  sourceField   MetaField @relation("SourceFields", fields: [sourceFieldId], references: [id])
  targetField   MetaField @relation("TargetFields", fields: [targetFieldId], references: [id])
  junctionTable MetaTable? @relation("JunctionTables", fields: [junctionTableId], references: [id])

  @@map("meta_relations")
}

// 元版本定义
model MetaVersion {
  id           String    @id @default(uuid())
  tableId      String
  version      Int
  name         String
  description   String?  @db.Text
  snapshot      Json
  isPublished   Boolean  @default(false)
  createdBy     String
  createdAt     DateTime @default(now())
  comment       String?  @db.Text

  // 关联关系
  table        MetaTable @relation(fields: [tableId], references: [id])
  modelApprovals ModelApproval[]

  @@unique([tableId, version])
  @@map("meta_versions")
}

// 元索引定义
model MetaIndex {
  id           String @id @default(uuid())
  tableId      String
  name         String
  type         String @default("btree")
  isUnique     Boolean @default(false)

  // 关联关系
  table        MetaTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  fields       MetaIndexField[]

  @@map("meta_indexes")
}

// 元索引字段关联
model MetaIndexField {
  id           String @id @default(uuid())
  indexId      String
  fieldId      String
  ordinal       Int

  // 关联关系
  index        MetaIndex @relation(fields: [indexId], references: [id], onDelete: Cascade)
  field        MetaField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@map("meta_index_fields")
}

// 元约束定义
model MetaConstraint {
  id           String @id @default(uuid())
  tableId      String
  name         String
  type         String
  fields       Json     // 字段ID数组
  expression   String?
  message      String?

  //  关联关系
  table        MetaTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("meta_constraints")
}


// 模型发布审批
model ModelApproval {
  id            String        @id @default(uuid())
  tableId       String
  versionId     String
  description   String        @db.Text
  attachments   String?       @db.Text
  status        String        @default("pending")
  requestedBy   String
  requestedAt   DateTime      @default(now())
  approvedBy    String?
  approvedAt    DateTime?
  comment       String?       @db.Text

  // 关联关系
  table         MetaTable     @relation(fields: [tableId], references: [id])
  version       MetaVersion   @relation(fields: [versionId], references: [id])

  @@map("model_approvals")
}

// 测试数据生成记录
model TestDataGeneration {
  id              String      @id @default(uuid())
  tableId         String
  count           Int
  includeRelations Boolean    @default(false)
  relationDepth   Int         @default(0)
  options         Json?
  createdBy       String
  createdAt       DateTime    @default(now())

  // 关联关系
  table           MetaTable   @relation(fields: [tableId], references: [id])

  @@map("test_data_generations")
}

// 测试数据模板
model TestDataTemplate {
  id              String      @id @default(uuid())
  name            String
  tableId         String
  description     String?     @db.Text
  fieldOverrides  Json
  createdBy       String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime?   @updatedAt

  // 关联关系
  table           MetaTable   @relation(fields: [tableId], references: [id])

  @@map("test_data_templates")
}

// 可视化图表
model VisualDiagram {
  id            String      @id @default(uuid())
  name          String
  description   String?     @db.Text
  tableIds      Json        // 数组
  elements      Json        // 数组
  connections   Json        // 数组
  settings      Json?
  createdBy     String
  createdAt     DateTime    @default(now())
  updatedBy     String?
  updatedAt     DateTime?   @updatedAt

  @@map("visual_diagrams")
}

// 表单模板
model Form {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  schema      String   @db.Text // JSON Schema
  description String?
  status      String   @default("draft")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  archivedAt  DateTime? @map("archived_at")

  formData    FormData[]

  @@map("forms")
}

model FormData {
  id        String   @id @default(uuid())
  formId    String
  data      String   @db.Text // JSON
  version   Int      @default(1)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  form      Form     @relation(fields: [formId], references: [id])

  @@map("form_data")
}

// 工作流定义
model WorkflowDefinition {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  description  String?  @db.Text
  definition   String   @db.Text // JSON格式存储流程定义数据
  version      Int      @default(1)
  status       String   @default("draft") // draft, published, deprecated
  categoryId   String?
  tags         String?  @db.Text // JSON数组存储标签
  tenantId     String?
  createdBy    String
  updatedBy    String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  publishedAt  DateTime? @map("published_at")

  // 关联关系
  versions     WorkflowVersion[]
  instances    WorkflowInstance[]

  @@map("workflow_definitions")
}

// 工作流版本
model WorkflowVersion {
  id           String   @id @default(uuid())
  workflowId   String
  version      Int
  definition   String   @db.Text
  changelog    String?  @db.Text
  createdBy    String
  createdAt    DateTime @default(now()) @map("created_at")
  publishedAt  DateTime? @map("published_at")
  status       String   @default("draft") // draft, published, deprecated

  // 关联关系
  workflow     WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version])
  @@map("workflow_versions")
}

// 节点类型
model NodeType {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  category     String   // event, task, gateway, boundary
  description  String?  @db.Text
  icon         String?
  properties   String   @db.Text // JSON格式存储节点属性定义
  isSystem     Boolean  @default(false) // 是否系统内置节点类型
  tenantId     String?  // 系统节点类型为null，自定义节点类型关联租户
  createdBy    String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("node_types")
}

// 工作流实例
model WorkflowInstance {
  id              String   @id @default(uuid())
  workflowId      String
  workflowVersion Int
  businessKey     String?  // 业务关联标识
  status          String   // running, completed, terminated, suspended
  variables       String   @db.Text // JSON格式存储流程变量
  startedBy       String
  startedAt       DateTime @default(now()) @map("started_at")
  endedAt         DateTime? @map("ended_at")
  tenantId        String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // 关联关系
  workflow        WorkflowDefinition @relation(fields: [workflowId], references: [id])
  tasks           WorkflowTask[]
  history         WorkflowHistory[]

  @@map("workflow_instances")
}

// 工作流任务
model WorkflowTask {
  id              String   @id @default(uuid())
  instanceId      String
  nodeId          String   // 流程定义中的节点ID
  nodeName        String
  nodeType        String
  status          String   // pending, claimed, completed, canceled
  assignee        String?  // 指派的用户ID
  candidateUsers  String?  @db.Text // JSON数组存储候选用户ID
  candidateGroups String?  @db.Text // JSON数组存储候选组ID
  formId          String?  // 关联的表单ID
  formData        String?  @db.Text // JSON格式存储表单数据
  dueDate         DateTime?
  priority        Int?     @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  claimedAt       DateTime? @map("claimed_at")
  completedAt     DateTime? @map("completed_at")
  tenantId        String?

  // 关联关系
  instance        WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("workflow_tasks")
}

// 工作流历史
model WorkflowHistory {
  id              String   @id @default(uuid())
  instanceId      String
  nodeId          String
  nodeName        String
  nodeType        String
  actionType      String   // start, complete, claim, delegate, suspend, resume, terminate
  actionBy        String
  actionAt        DateTime @default(now()) @map("action_at")
  comments        String?  @db.Text
  previousState   String?
  currentState    String
  variables       String?  @db.Text // JSON格式存储当时的变量
  tenantId        String?
  createdAt       DateTime @default(now()) @map("created_at")

  // 关联关系
  instance        WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("workflow_history")
}

// npx prisma generate

